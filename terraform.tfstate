    {
      "mode": "managed",
      "type": "local_file",
      "name": "core_site_rendered",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "\u003cconfiguration\u003e\n    \u003c!-- Default FS: Hive warehouse main bucket --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.defaultFS\u003c/name\u003e\n        \u003cvalue\u003es3a://hive-warehouse/\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Access/secret from environment variables --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.access.key\u003c/name\u003e\n        \u003cvalue\u003eminioadmin\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.secret.key\u003c/name\u003e\n        \u003cvalue\u003eminioadminpassword\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- MinIO endpoint --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.endpoint\u003c/name\u003e\n        \u003cvalue\u003ehttp://minio:9000\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Path style access for MinIO --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.path.style.access\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.impl\u003c/name\u003e\n        \u003cvalue\u003eorg.apache.hadoop.fs.s3a.S3AFileSystem\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Optional tuning --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.maximum\u003c/name\u003e\n        \u003cvalue\u003e100\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.fast.upload\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n\u003c/configuration\u003e\n",
            "content_base64": null,
            "content_base64sha256": "Ydgu2iFhRcAaCoPV7LHDcfPO0uw2V7ZEqBzIc7zyCbo=",
