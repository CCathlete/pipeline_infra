            "command": [
              "bash",
              "-c",
              "echo \"Waiting for Metadata Postgres at postgres_metadata_db:5432...\"\nuntil PGPASSWORD=thisismypgpass12 psql -h postgres_metadata_db -U kcat -d metadata -c 'select 1' \u003e /dev/null 2\u003e\u00261; do\n  echo \"Metadata Postgres is unavailable - sleeping\"\n  sleep 1\ndone\necho \"Metadata Postgres is ready! Starting Airflow process...\"\nairflow db init \u0026\u0026 airflow users create --username airflow --firstname Admin --lastname User --role Admin --email admin@example.com --password airflow\n"
