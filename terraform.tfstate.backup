    {
      "mode": "managed",
      "type": "local_file",
      "name": "core_site_rendered",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "\u003cconfiguration\u003e\n    \u003c!-- Default FS: Hive warehouse main bucket --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.defaultFS\u003c/name\u003e\n        \u003cvalue\u003es3a://lakehouse/\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Access/secret from environment variables --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.access.key\u003c/name\u003e\n        \u003cvalue\u003eminioadmin\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.secret.key\u003c/name\u003e\n        \u003cvalue\u003eminioadminpassword\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- MinIO endpoint --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.endpoint\u003c/name\u003e\n        \u003cvalue\u003ehttp://minio_storage:9000\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Path style access for MinIO --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.path.style.access\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.impl\u003c/name\u003e\n        \u003cvalue\u003eorg.apache.hadoop.fs.s3a.S3AFileSystem\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Optional tuning --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.maximum\u003c/name\u003e\n        \u003cvalue\u003e100\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.fast.upload\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n    \u003cname\u003efs.s3a.connection.timeout\u003c/name\u003e\n    \u003cvalue\u003e60\u003c/value\u003e \u003c!-- 60 seconds --\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.establish.timeout\u003c/name\u003e\n        \u003cvalue\u003e60\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.request.timeout\u003c/name\u003e\n        \u003cvalue\u003e60\u003c/value\u003e\n    \u003c/property\u003e\n\u003c/configuration\u003e\n",
            "content_base64": null,
            "content_base64sha256": "GLHr3itd4YmvBQIIWaimNvPdrmGXreqgps4EAzgqam8=",
            "content_base64sha512": "Wwj8sUrL/kFrqHPoFsCK/uwiuy/P99jqcx2p0+bcyd1Npjpkquk4uq1cLnUd8nY3bnGDkjbkEme4Z4Uh+SLRfg==",
            "content_md5": "cc4f71f11c995b2d69b49158f85d25ed",
            "content_sha1": "1636306e972a8a9405ff677fb4b908b17e521198",
            "content_sha256": "18b1ebde2b5de189af05020859a8a636f3ddae6197adeaa0a6ce0403382a6a6f",
            "content_sha512": "5b08fcb14acbfe416ba873e816c08afeec22bb2fcff7d8ea731da9d3e6dcc9dd4da63a64aae938baad5c2e751df276376e71839236e41267b8678521f922d17e",
            "directory_permission": "0777",
            "file_permission": "0777",
            "filename": "/home/kcat/Repos/pipeline_infra/generated/core-site.xml",
            "id": "1636306e972a8a9405ff677fb4b908b17e521198",
