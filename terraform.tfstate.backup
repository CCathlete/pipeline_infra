    {
      "mode": "managed",
      "type": "local_file",
      "name": "core_site_rendered",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "\u003cconfiguration\u003e\n    \u003c!-- Default FS: Hive warehouse main bucket --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.defaultFS\u003c/name\u003e\n        \u003cvalue\u003es3a://hive-warehouse/\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Access/secret from environment variables --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.access.key\u003c/name\u003e\n        \u003cvalue\u003eminioadmin\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.secret.key\u003c/name\u003e\n        \u003cvalue\u003eminioadminpassword\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- MinIO endpoint --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.endpoint\u003c/name\u003e\n        \u003cvalue\u003ehttp://minio:9000\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Path style access for MinIO --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.path.style.access\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.impl\u003c/name\u003e\n        \u003cvalue\u003eorg.apache.hadoop.fs.s3a.S3AFileSystem\u003c/value\u003e\n    \u003c/property\u003e\n\n    \u003c!-- Optional tuning --\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.maximum\u003c/name\u003e\n        \u003cvalue\u003e100\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.fast.upload\u003c/name\u003e\n        \u003cvalue\u003etrue\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n    \u003cname\u003efs.s3a.connection.timeout\u003c/name\u003e\n    \u003cvalue\u003e60000\u003c/value\u003e \u003c!-- 60 seconds in milliseconds --\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.establish.timeout\u003c/name\u003e\n        \u003cvalue\u003e60000\u003c/value\u003e\n    \u003c/property\u003e\n    \u003cproperty\u003e\n        \u003cname\u003efs.s3a.connection.request.timeout\u003c/name\u003e\n        \u003cvalue\u003e60000\u003c/value\u003e\n    \u003c/property\u003e\n\u003c/configuration\u003e\n",
            "content_base64": null,
            "content_base64sha256": "GUlZDU1SUhhxAh9Rx89WJYiQo/askLKHj6wDIrLOAh4=",
            "content_base64sha512": "Rw83uaQ4UCcsdV59UunNFk4ADDwvfRFdkB1RmW3AQpQyG9f8vmBu/88NR4h5dxt2gNOFRHbMKCXWk05XYgvnDg==",
            "content_md5": "97abdb1fe9b35d12ec4a44d74690c187",
            "content_sha1": "eb287991129085e79aa9f0a18dcb3368d19e2906",
            "content_sha256": "1949590d4d52521871021f51c7cf56258890a3f6ac90b2878fac0322b2ce021e",
            "content_sha512": "470f37b9a43850272c755e7d52e9cd164e000c3c2f7d115d901d51996dc04294321bd7fcbe606effcf0d478879771b7680d3854476cc2825d6934e57620be70e",
            "directory_permission": "0777",
